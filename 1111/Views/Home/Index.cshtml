@model _1111.Models.GamingLandingViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<_1111.Models.ApplicationUser> UserManager
@{
    Layout = "_Layout";
    ViewData["Title"] = "CYBERZONE";
    var totalStations = Model.Zones.Sum(z => z.Computers.Count);
    var vipRooms = Model.Zones.Count(z => z.Name.Contains("VIP"));
    var consoles = Model.Zones.Count(z => z.Name.Contains("Console"));
}

<style>
    :root {
        --bg: #0B0E14;
        --surface: #111827;
        --surface-2: #121826;
        --text: #E5E7EB;
        --muted: #94A3B8;
        --brand: #3B82F6;
        --neon: #22D3EE;
        --violet: #A78BFA;
        --border: rgba(59, 130, 246, .25);
    }

    body {
        background: radial-gradient(circle at 15% 10%, rgba(59, 130, 246, .12), transparent 35%), var(--bg);
    }

    .hero {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 30px;
        padding: 60px 0 36px;
    }

    .tag {
        display: inline-block;
        font-size: 12px;
        color: #93C5FD;
        padding: 6px 12px;
        border: 1px solid var(--border);
        border-radius: 999px;
        margin-bottom: 18px;
        background: rgba(59, 130, 246, .1);
    }

    h1 {
        font-size: clamp(34px, 5vw, 62px);
        line-height: 1.02;
        margin: 0 0 18px;
        letter-spacing: -1.2px;
    }

    .gradient-text {
        background: linear-gradient(90deg, #22D3EE, #3B82F6, #A78BFA);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .hero p {
        color: #A8B3C8;
        max-width: 520px;
        margin: 0 0 24px;
        line-height: 1.55;
    }

    .hero-actions { display: flex; gap: 12px; }

    .stats {
        display: grid;
        gap: 14px;
        align-content: start;
    }

    .panel {
        background: linear-gradient(180deg, rgba(17, 24, 39, .95), rgba(16, 23, 36, .95));
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
        box-shadow: inset 0 0 24px rgba(34, 211, 238, .04);
    }

    .panel h4 {
        margin: 0 0 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .live-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .live-card {
        background: #1B2438;
        border: 1px solid rgba(59, 130, 246, .28);
        border-radius: 12px;
        padding: 11px;
    }

    .live-card strong { font-size: 24px; display: block; color: #60A5FA; }
    .live-card span { color: var(--muted); font-size: 12px; }

    .times {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .time-chip {
        font-size: 12px;
        color: #BFDBFE;
        border: 1px solid rgba(59, 130, 246, .38);
        border-radius: 10px;
        padding: 6px 10px;
        background: rgba(59, 130, 246, .12);
    }

    .section-title {
        text-align: center;
        margin: 48px 0 24px;
    }

    .section-title h2 {
        margin: 0 0 6px;
        font-size: 42px;
        letter-spacing: -0.8px;
    }

    .section-title p { margin: 0; color: var(--muted); }

    .zones {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 56px;
    }

    .zone-card {
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        background: #111827;
        box-shadow: 0 12px 28px rgba(2, 6, 23, .45);
    }

    .zone-card img {
        width: 100%;
        height: 184px;
        object-fit: cover;
        display: block;
    }

    .zone-body {
        padding: 16px;
        display: grid;
        gap: 10px;
    }

    .zone-body h3 { margin: 0; font-size: 23px; }
    .zone-body p { margin: 0; color: #A7B1C3; font-size: 14px; line-height: 1.45; }
    .hardware {
        color: var(--neon);
        font-size: 13px;
        font-weight: 600;
    }

    .specs {
        border-top: 1px solid rgba(148, 163, 184, .18);
        padding-top: 8px;
        display: grid;
        gap: 6px;
    }

    .spec-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 12px;
        color: #CBD5E1;
    }

    .price {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2px;
        font-weight: 600;
    }

    .price span { color: #C4B5FD; }

    .btn {
        border: 0;
        border-radius: 11px;
        padding: 10px 18px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s ease;
    }

    .btn-primary {
        color: white;
        background: linear-gradient(90deg, #3B82F6, #8B5CF6);
        box-shadow: 0 6px 20px rgba(59, 130, 246, .32);
    }

    .btn-primary:hover { filter: brightness(1.08); }

    .btn-outline {
        color: #E2E8F0;
        border: 1px solid rgba(59, 130, 246, .35);
        background: rgba(17, 24, 39, .7);
    }

    @@media (max-width: 980px) {
        .hero,
        .zones {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="hero">
    <div>
        <span class="tag">Премиальный игровой опыт</span>
        <h1>
            Забронируйте
            <span class="gradient-text">игровое место</span>
            за минуты
        </h1>
        <p>
            Бронируйте игровые ПК, VIP-комнаты и консольные зоны онлайн. Играйте на новейшем оборудовании
            с друзьями в нашем премиальном клубе.
        </p>
        <div class="hero-actions"> 
            @if (User.Identity?.IsAuthenticated != true) 
            { 
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Забронировать</a> 
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline">Мои бронирования</a>
            } 
            else 
            { 
                <a asp-controller="Bookings" asp-action="Reserve" class="btn btn-primary">Забронировать</a> 
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline">Мои бронирования</a>
            } 
        </div>
    </div>

    <div class="stats">
        <div class="panel">
            <h4>Доступно сейчас</h4>
            <div class="live-grid">
                <div class="live-card">
                    <strong>@totalStations</strong>
                    <span>ПК свободно</span>
                </div>
                <div class="live-card">
                    <strong>@vipRooms</strong>
                    <span>VIP-комнаты</span>
                </div>
                <div class="live-card">
                    <strong>@consoles</strong>
                    <span>Консоли</span>
                </div>
            </div>
        </div>
        <div class="panel">
            <h4>Популярное время</h4>
            <div class="times">
                <span class="time-chip">14:00</span>
                <span class="time-chip">16:00</span>
                <span class="time-chip">18:00</span>
                <span class="time-chip">20:00</span>
                <span class="time-chip">22:00</span>
            </div>
        </div>
    </div>
</section>

<div class="section-title">
    <h2>Игровые зоны</h2>
    <p>Выберите идеальную игровую среду</p>
</div>

<section class="zones">
    @foreach (var zone in Model.Zones)
    {
        string imagePath;
        
        // Case-insensitive zone category matching with proper fallback
        if (!string.IsNullOrEmpty(zone.ZoneCategory))
        {
            if (zone.ZoneCategory.Contains("VIP", StringComparison.OrdinalIgnoreCase))
            {
                imagePath = Url.Content("~/img/vip.jpg");
            }
            else if (zone.ZoneCategory.Contains("Console", StringComparison.OrdinalIgnoreCase))
            {
                imagePath = Url.Content("~/img/console.jpg");
            }
            else if (zone.ZoneCategory.Contains("PC", StringComparison.OrdinalIgnoreCase))
            {
                imagePath = Url.Content("~/img/PCzone.png");
            }
            else
            {
                imagePath = Url.Content("~/img/GamingStation.png");
            }
        }
        else
        {
            // Fallback for null/empty zone category
            imagePath = Url.Content("~/img/GamingStation.png");
        }
        
        var statusText = zone.IsOccupiedNow ? "Занято" : "Доступно";
        var statusColor = zone.IsOccupiedNow ? "#ef4444" : "#22c55e";

        <article class="zone-card">
            <img src="@imagePath" alt="" onerror="this.src='@Url.Content("~/img/GamingStation.png")'" />
            <div class="zone-body">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                    <h3>@zone.Name</h3>
                    <span style="font-size:12px; font-weight:700; color:white; padding:4px 10px; border-radius:999px; background:@statusColor;">@statusText</span>
                </div>
                <p>@zone.Description</p>
                <div class="hardware">@zone.Hardware</div>

                <div class="specs">
                    @foreach (var pc in zone.Computers)
                    {
                        <div class="spec-row">
                            <span>@pc.Name: @pc.Cpu / @pc.Gpu</span>
                            <span>@pc.Ram</span>
                        </div>
                    }
                </div>

                <div class="price">
                    <span>Бронирование ресурса</span>
                    <a asp-controller="Bookings"
                       asp-action="Reserve"
                       class="btn btn-primary"
                       style="padding:8px 14px;">Забронировать</a>
                </div>
            </div>
        </article>
    }
</section>
