@inject Microsoft.AspNetCore.Identity.UserManager<_1111.Models.ApplicationUser> UserManager
@inject _1111.Data.ApplicationDbContext DbContext
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.UserName ?? "Player";
    var unreadNotifications = currentUser is null
        ? 0
        : DbContext.Notifications.Count(n => n.UserId == currentUser.Id && !n.IsRead);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CYBERZONE</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: "Inter", "Segoe UI", sans-serif; }
        .container { width: min(1200px, 92%); margin: 0 auto; }
        .nav-link { position: relative; transition: all 0.3s ease; }
        .nav-link:hover { color: #22D3EE; text-shadow: 0 0 8px rgba(34, 211, 238, 0.6); }
        .nav-link.active { color: #22D3EE; text-shadow: 0 0 12px rgba(34, 211, 238, 0.8); }
        .nav-link::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: linear-gradient(90deg, #22D3EE, #3B82F6); transition: width 0.3s ease; }
        .nav-link:hover::after { width: 100%; }
    </style>
</head>
<body class="bg-[#0B0E14] text-slate-100">
    <header class="sticky top-0 z-50 border-b border-blue-400/20 bg-[#0B0E14]/90 backdrop-blur">
        <div class="container flex items-center justify-between gap-4 py-3">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 no-underline">
                <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 p-2">
                    <img src="/img/boxicons_joystick.png" alt="Logo" class="h-full w-full object-contain brightness-0 invert" />
                </div>
                <div class="leading-tight">
                    <div class="font-bold tracking-wide text-white">CYBERZONE</div>
                    <div class="text-xs font-medium text-cyan-300">Gaming Club</div>
                </div>
            </a>

            <nav class="hidden md:flex items-center justify-center flex-1 gap-6 text-sm text-slate-300">
                <a asp-controller="Home" asp-action="Index" class="nav-link hover:text-white">Home</a>
                <a asp-controller="Bookings" asp-action="Reserve" class="nav-link hover:text-white">Stations/Browse</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Bookings" asp-action="Index" class="nav-link hover:text-white">My Bookings</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index" class="nav-link hover:text-white text-cyan-300 font-semibold">Admin Panel</a>
                }
            </nav>

            <div class="flex items-center gap-2 text-sm">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Notifications" asp-action="Index" class="relative rounded-xl border border-slate-600 px-3 py-2 text-slate-300 transition hover:text-white" title="Notifications" aria-label="Notifications">
                        <span>🔔</span>
                        @if (unreadNotifications > 0)
                        {
                            <span class="absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                        }
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="text-blue-100 hover:text-white">@displayName</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="rounded-xl border border-slate-600 px-3 py-2 text-slate-300 transition hover:text-white">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-blue-100 hover:text-white">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="rounded-xl bg-gradient-to-r from-blue-500 to-violet-500 px-3 py-2 font-semibold text-white shadow-lg shadow-blue-500/20 transition hover:brightness-110">Sign Up</a>
                }
            </div>
        </div>
    </header>

    <main class="container py-8">
        @RenderBody()
    </main>

    <footer class="mt-12 border-t border-blue-400/20 bg-[#0A0D15]">
        <div class="container grid gap-6 py-8 md:grid-cols-4">
            <div>
                <div class="mb-2 flex items-center gap-2">
                    <div class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-lg bg-gradient-to-br from-blue-600 to-indigo-700 p-2">
                        <img src="/img/boxicons_joystick.png" alt="Logo" class="h-full w-full object-contain brightness-0 invert" />
                    </div>
                    <div>
                        <div class="font-semibold">CYBERZONE</div>
                        <div class="text-xs text-cyan-300">Gaming Club</div>
                    </div>
                </div>
                <p class="text-sm text-slate-400">Premium gaming station booking platform for students and gamers.</p>
            </div>
            <div>
                <h4 class="mb-2 font-semibold">Quick Links</h4>
                <ul class="space-y-1 text-sm text-slate-400">
                    <li>Browse Stations</li>
                    <li>My Bookings</li>
                    <li>About Club</li>
                </ul>
            </div>
            <div>
                <h4 class="mb-2 font-semibold">Opening Hours</h4>
                <ul class="space-y-1 text-sm text-slate-400">
                    <li>Mon-Fri: 10:00 - 23:00</li>
                    <li>Sat-Sun: 12:00 - 02:00</li>
                </ul>
            </div>
            <div>
                <h4 class="mb-2 font-semibold">Contact</h4>
                <ul class="space-y-1 text-sm text-slate-400">
                    <li>borodako.k@@gmail.com</li>
                    <li>+375 (29) 149-83-22</li>
                    <li>456 Tech Street</li>
                </ul>
            </div>
        </div>
        <div class="border-t border-slate-700/40 py-4 text-center text-sm text-slate-500">
            &copy; 2026 CYBERZONE Gaming Club. Course Project - Built with ASP.NET MVC.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
