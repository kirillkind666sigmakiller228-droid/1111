@model _1111.Models.ApplicationUser
@{
    ViewData["Title"] = "Profile";
}

<div class="min-h-screen bg-[#0B0E14] py-8 text-slate-100">
    <div class="mx-auto w-[92%] max-w-3xl">
        <div class="rounded-2xl border border-blue-400/20 bg-slate-900/70 p-6">
            <h1 class="mb-5 text-2xl font-bold text-white">My Profile</h1>
            <div class="grid gap-4">
                <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">Username</p>
                    <p class="text-base text-slate-100">@Model.UserName</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">Email</p>
                    <p class="text-base text-slate-100">@Model.Email</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wider text-slate-400">Phone number</p>
                    <p class="text-base text-cyan-300">@Model.PhoneNumber</p>
                </div>
            </div>
        </div>
    </div>
</div>
