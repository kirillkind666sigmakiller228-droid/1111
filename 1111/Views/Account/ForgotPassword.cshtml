@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CYBERZONE</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: "Inter", "Segoe UI", sans-serif;
            background: #0B0E14;
        }

        .auth-page {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: #0B0E14;
        }

        .auth-card {
            position: relative;
            width: min(480px, 100%);
            background: #111827;
            border: 1px solid rgba(59, 130, 246, .3);
            border-radius: 1rem;
            padding: 28px;
            box-shadow: 0 20px 50px rgba(2, 6, 23, .5);
        }

        .auth-card h1 {
            margin: 0 0 8px;
            color: #E5E7EB;
            font-size: 32px;
        }

        .subtitle {
            margin: 0 0 18px;
            color: #94A3B8;
        }

        .auth-card form {
            display: grid;
            gap: 10px;
        }

        .auth-card label {
            color: #CBD5E1;
            font-weight: 600;
            margin-top: 6px;
        }

        .auth-card input {
            width: 100%;
            background: #0F172A;
            color: #E2E8F0;
            border: 1px solid #1E3A8A;
            border-radius: 14px;
            padding: 11px 12px;
            outline: none;
            transition: .2s ease;
        }

        .auth-card input:focus {
            border-color: #60A5FA;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .25), 0 0 16px rgba(59, 130, 246, .18);
        }

        .btn-gradient {
            margin-top: 10px;
            border: 0;
            border-radius: 14px;
            padding: 12px;
            color: white;
            font-weight: 700;
            cursor: pointer;
            background: linear-gradient(90deg, #3B82F6, #8B5CF6);
        }

        .field-error, .error-list {
            color: #FCA5A5;
            font-size: 13px;
        }

        .error-list ul {
            margin: 0;
            padding-left: 16px;
        }

        .hint {
            margin: 16px 0 0;
            color: #94A3B8;
        }

        .hint a {
            color: #93C5FD;
            text-decoration: none;
        }

        .close-btn {
            position: absolute;
            top: 10px;
            right: 12px;
            color: #9CA3AF;
            text-decoration: none;
            font-size: 26px;
            line-height: 1;
            transition: color .2s ease;
        }

        .close-btn:hover {
            color: #FFFFFF;
        }

        .success-message {
            background: #10b981;
            color: white;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 16px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <a asp-controller="Home" asp-action="Index" class="close-btn" aria-label="Back to home">&times;</a>
            <h1>Forgot Password</h1>
            <p class="subtitle">Enter your email address and we'll send you a link to reset your password.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="error-list"></div>

                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required placeholder="Enter your email address" />
                @if (ViewData.ModelState?.ErrorCount > 0 && ViewData.ModelState.ContainsKey("email"))
                {
                    <span class="field-error">@ViewData.ModelState["email"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                }

                <button type="submit" class="btn-gradient">Send Reset Link</button>
            </form>

            <p class="hint">Remember your password? <a asp-controller="Account" asp-action="Login">Back to Sign In</a></p>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
