@model IEnumerable<_1111.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

        <div class="mb-6 flex items-center justify-between">
            <h1 class="text-3xl font-extrabold tracking-tight text-white">Notifications</h1>
            <a asp-controller="Bookings" asp-action="Index" class="rounded-lg border border-blue-400/40 bg-slate-900 px-3 py-2 text-xs font-semibold text-blue-200 transition hover:border-cyan-300 hover:text-cyan-200">
                Back to My Bookings
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="rounded-2xl border border-blue-400/20 bg-slate-900/70 p-6 text-slate-300">
                No notifications yet.
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var notification in Model)
                {
                    <article class="rounded-xl border border-blue-400/20 bg-slate-900/70 p-4">
                        <p class="text-sm text-slate-100">@notification.Message</p>
                        <p class="mt-1 text-xs text-slate-400">@notification.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                    </article>
                }
            </div>
        }
    
